{
  "schemaVersion": "2026-07-06",
  "description": "Target ownership and dependency policy for src/services. This manifest classifies the current flat service tree during the staged module-containment refactor.",
  "sourceRoot": "src/services",
  "excludedFiles": [
    "src/services/module-ownership.json"
  ],
  "modules": {
    "shared": {
      "targetPath": "src/services/shared",
      "purpose": "Browser-safe primitives shared across service modules: hashes, ids, errors, config contracts, serialization helpers.",
      "allowedImports": ["shared"]
    },
    "platform": {
      "targetPath": "src/services/platform",
      "purpose": "Host/platform adapters: provider clients, telemetry, resource pools, browser acceleration, runtime feature detection.",
      "allowedImports": ["shared", "platform"]
    },
    "mcp": {
      "targetPath": "src/services/mcp",
      "purpose": "MCP protocol, registries, descriptors, policy broker, transport, and schema/UI descriptor orchestration.",
      "allowedImports": ["shared", "platform", "mcp", "logic.shared", "provers", "zkp"]
    },
    "glasses": {
      "targetPath": "src/services/glasses",
      "purpose": "Meta-glasses/orb/webapp control surfaces, adapters, widget compilation, and display/input/audio/camera profiles.",
      "allowedImports": ["shared", "platform", "mcp", "glasses", "ipfs"]
    },
    "ipfs": {
      "targetPath": "src/services/ipfs",
      "purpose": "IPFS interface descriptors, UI profiles, widgets, and storage/cache integration points.",
      "allowedImports": ["shared", "platform", "mcp", "glasses", "ipfs", "proof-engine"]
    },
    "logic.shared": {
      "targetPath": "src/services/logic/shared",
      "purpose": "Common theorem-prover domain types, formula analyzers, parsers, validation, canonicalization, and proof metadata.",
      "allowedImports": ["shared", "logic.shared", "provers"]
    },
    "logic.nl": {
      "targetPath": "src/services/logic/nl",
      "purpose": "Natural-language parsing, policy compilation, multilingual parsers, grammar loading, and sentence-level conversion helpers.",
      "allowedImports": ["shared", "logic.shared", "logic.nl", "logic.fol", "logic.deontic", "logic.tdfol", "logic.dcec"]
    },
    "logic.fol": {
      "targetPath": "src/services/logic/fol",
      "purpose": "FOL parsing, formatting, conversion, export, symbolic FOL helpers, and FOL-specific syntax validation.",
      "allowedImports": ["shared", "logic.shared", "logic.fol", "provers"]
    },
    "logic.tdfol": {
      "targetPath": "src/services/logic/tdfol",
      "purpose": "TDFOL core AST, parser, prover, temporal/deontic APIs, strategy routing, optimization, and performance helpers.",
      "allowedImports": ["shared", "logic.shared", "logic.fol", "logic.tdfol", "logic.deontic", "logic.cec", "logic.dcec", "provers", "zkp"]
    },
    "logic.dcec": {
      "targetPath": "src/services/logic/dcec",
      "purpose": "DCEC core types, grammar/parsing, prototypes, integration, and DCEC-specific error handling.",
      "allowedImports": ["shared", "logic.shared", "logic.dcec", "logic.cec"]
    },
    "logic.cec": {
      "targetPath": "src/services/logic/cec",
      "purpose": "CEC/Event Calculus rules, tableaux, fluents, context, proof cache, and CEC prover management.",
      "allowedImports": ["shared", "logic.shared", "logic.cec", "logic.dcec", "logic.deontic", "logic.modal", "zkp"]
    },
    "logic.deontic": {
      "targetPath": "src/services/logic/deontic",
      "purpose": "Deontic parsing, norm IR, formula building, legal-text extraction, conflict detection, and normative graph projection.",
      "allowedImports": ["shared", "logic.shared", "logic.nl", "logic.fol", "logic.deontic", "logic.modal", "logic.bridges", "provers", "zkp"]
    },
    "logic.modal": {
      "targetPath": "src/services/logic/modal",
      "purpose": "Modal codec/compiler/decompiler/tableaux, Kripke structures, KG bridges, ambiguity handling, and modal synthesis.",
      "allowedImports": ["shared", "logic.shared", "logic.nl", "logic.fol", "logic.deontic", "logic.modal", "provers"]
    },
    "logic.bridges": {
      "targetPath": "src/services/logic/bridges",
      "purpose": "Cross-logic bridge adapters and graph/multiview projections across FOL, TDFOL, CEC, DCEC, modal, and deontic views.",
      "allowedImports": ["shared", "logic.shared", "logic.fol", "logic.tdfol", "logic.cec", "logic.dcec", "logic.deontic", "logic.modal", "logic.bridges", "provers", "zkp"]
    },
    "provers": {
      "targetPath": "src/services/provers",
      "purpose": "Concrete prover adapters and prover-facing serializers for Z3, CVC5, Coq, Lean, DCEC, TDFOL, Lurk, STARK, and neural prover bridges.",
      "allowedImports": ["shared", "logic.shared", "logic.fol", "logic.tdfol", "logic.dcec", "logic.deontic", "provers"]
    },
    "zkp": {
      "targetPath": "src/services/zkp",
      "purpose": "ZKP statements, circuits, proving backends, browser ZKP, UCAN bridge, on-chain bridge, artifacts, witness/key management.",
      "allowedImports": ["shared", "platform", "logic.shared", "logic.tdfol", "logic.deontic", "logic.cec", "provers", "zkp"]
    },
    "proof-engine": {
      "targetPath": "src/services/proof-engine",
      "purpose": "Proof execution, proof trees, proof strategies, caches, explainers, formula dependency graphs, and proof-engine contracts.",
      "allowedImports": ["shared", "logic.shared", "provers", "proof-engine"]
    },
    "integrations": {
      "targetPath": "src/services/integrations",
      "purpose": "External/optional integration wrappers: FLogic, ErgoAI, ShadowProver, spaCy WASM, neurosymbolic services, UCAN policy bridges.",
      "allowedImports": ["shared", "platform", "logic.shared", "logic.fol", "logic.deontic", "logic.tdfol", "logic.modal", "provers", "zkp", "proof-engine", "integrations"]
    },
    "legacy": {
      "targetPath": "src/services/legacy",
      "purpose": "Temporary holding area for sprint bundles and files whose ownership still needs human review before movement.",
      "allowedImports": ["shared", "platform", "mcp", "glasses", "ipfs", "logic.shared", "logic.nl", "logic.fol", "logic.tdfol", "logic.cec", "logic.dcec", "logic.deontic", "logic.modal", "logic.bridges", "provers", "zkp", "proof-engine", "integrations", "legacy"]
    }
  },
