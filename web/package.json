{
  "name": "swissknife-web",
  "version": "1.0.0",
  "description": "SwissKnife Web Desktop - Browser compilation of SwissKnife",
  "scripts": {
    "build": "webpack --config webpack.browser.config.js",
    "watch": "webpack --watch --config webpack.browser.config.js",
    "build:dev": "webpack --config webpack.config.js --mode=development",
    "dev": "webpack serve --config webpack.config.js --mode=development",
    "dev:alt": "npm run build:dev && npm run serve:dev",
    "serve": "npx http-server dist -p 8000 -c-1 --cors -o --no-cache",
    "serve:fresh": "npm run clean && npm run build && npm run serve",
    "serve:dev": "npm run build:dev && npm run serve",
    "serve:prod": "npm run build && npm run serve",
    "clean": "rm -rf dist",
    "test:build": "npm run build:dev && npm run serve"
  },
  "devDependencies": {
    "@types/webpack-env": "^1.18.5",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.5.2",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "@types/node": "^20.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.1",
    "style-loader": "^3.3.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-dev-server": "^4.15.0",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.24.7",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.0",
    "events": "^3.3.0",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.3",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "@anthropic-ai/sdk": "^0.55.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@huggingface/inference": "^4.3.2",
    "@ipld/dag-cbor": "^9.2.4",
    "@libp2p/noise": "^12.0.1",
    "@storacha/access": "^1.2.2",
    "@storacha/capabilities": "^1.7.0",
    "@storacha/client": "^1.4.0",
    "@storacha/ucn": "^1.1.0",
    "babel-loader": "^10.0.0",
    "globalthis": "^1.0.0",
    "helia": "^5.4.2",
    "ipfs-accelerate-js": "file:../ipfs_accelerate_js",
    "libp2p": "^2.8.14",
    "multiformats": "^13.3.7",
    "nanoid": "^5.1.5",
    "node-libs-browser": "^2.2.1",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "openai": "^5.8.2",
    "querystring-es3": "^0.2.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  }
}
