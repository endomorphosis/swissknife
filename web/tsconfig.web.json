{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2021"],
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "declaration": false,
    "declarationDir": null,
    "composite": false,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@swissknife/*": ["../src/*"],
      "@legacy/*": ["js/*"],
      "@/*": ["src/*"]
    },
    "types": ["node", "webpack-env"]
  },
  "include": [
    "src/**/*",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "js/**/*",
    "legacy-js/**/*"
  ]
}
