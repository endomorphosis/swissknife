{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "training-manager",
  "description": "Run one bounded gpt2 owner execution for the isolated dataset, read that execution record back after reopen, and correct an invalid dataset with a second bounded run.",
  "fixture_scope": "svf-training-manager-g032",
  "variables": {
    "inference_model": "gpt2",
    "dataset_id": "svf-training-isolated"
  },
  "backend_bindings": [
    {
      "binding_id": "training-manager.ipfs_accelerate_py.preview_training_task",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/status",
        "operator": "equals",
        "expected": "completed"
      }
    },
    {
      "binding_id": "training-manager.ipfs_accelerate_py.inspect_job_state",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/read_from_execution_record",
        "operator": "equals",
        "expected": true
      }
    }
  ],
  "phases": {
    "primary_result": [
      {"op": "fill", "selector": "#training-dataset-id", "value": "svf-training-isolated"},
      {"op": "fill", "selector": "#training-model-id", "value": "gpt2"},
      {"op": "click", "selector": "#launch-governed-training"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.preview_training_task\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.preview_training_task\"]"},
      {"op": "wait_for", "selector": "#training-owner-job[data-owner-run=\"1\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "press", "selector": "#training-model-id", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#training-owner-job"}, "operator": "contains", "expected": "status completed model gpt2 dataset svf-training-isolated queue not used"}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "click", "selector": "#read-owner-job"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.inspect_job_state\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.inspect_job_state\"]"},
      {"op": "wait_for", "selector": "#training-reopened-record[data-reopened=\"read\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#training-reopened-record"}, "operator": "contains", "expected": "status completed model gpt2 dataset svf-training-isolated read from execution record"}
    ],
    "failure_recovery": [
      {"op": "fill", "selector": "#training-dataset-id", "value": "invalid"},
      {"op": "press", "selector": "#training-dataset-id", "key": "Enter"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#training-config-error"}, "operator": "contains", "expected": "Invalid data"},
      {"op": "fill", "selector": "#training-dataset-id", "value": "svf-training-isolated"},
      {"op": "click", "selector": "#retry-bounded-owner"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.preview_training_task\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.preview_training_task\"]"},
      {"op": "wait_for", "selector": "#training-owner-job[data-owner-run=\"2\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "text", "selector": "#training-owner-job"}, "operator": "contains", "expected": "status completed model gpt2 dataset svf-training-isolated queue not used"}
    ]
  }
}
