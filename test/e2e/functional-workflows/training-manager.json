{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "training-manager",
  "description": "Validate an isolated dataset and model, reopen that saved configuration, and correct invalid input without treating a preview as a training job.",
  "fixture_scope": "svf-training-manager-g032",
  "variables": {
    "inference_model": "gpt2",
    "dataset_id": "svf-training-isolated"
  },
  "backend_bindings": [
    {
      "binding_id": "training-manager.ipfs_accelerate_py.preview_training_task",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/inference_executed",
        "operator": "equals",
        "expected": true
      }
    }
  ],
  "phases": {
    "primary_result": [
      {"op": "fill", "selector": "#training-dataset-id", "value": "svf-training-isolated"},
      {"op": "fill", "selector": "#training-model-id", "value": "gpt2"},
      {"op": "press", "selector": "#training-model-id", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#training-config-status"}, "operator": "equals", "expected": "Preview only for dataset svf-training-isolated and model gpt2. No capacity has been observed, so no job was queued. Configuration remains editable."},
      {"op": "click", "selector": "#launch-governed-training"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.preview_training_task\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.preview_training_task\"]"}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#training-config-status"}, "operator": "equals", "expected": "Saved configuration dataset svf-training-isolated and model gpt2."}
    ],
    "failure_recovery": [
      {"op": "fill", "selector": "#training-dataset-id", "value": "invalid"},
      {"op": "press", "selector": "#training-dataset-id", "key": "Enter"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#training-config-error"}, "operator": "contains", "expected": "Invalid data"},
      {"op": "fill", "selector": "#training-dataset-id", "value": "svf-training-isolated"},
      {"op": "click", "selector": "#validate-training-config"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "value", "selector": "#training-dataset-id"}, "operator": "equals", "expected": "svf-training-isolated"}
    ]
  }
}
