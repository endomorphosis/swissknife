{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "training-manager",
  "description": "Run one bounded gpt2 owner execution for the isolated dataset, read that execution record back after reopen, and correct an invalid dataset with a second bounded run.",
  "fixture_scope": "svf-training-manager-g032",
  "variables": {
    "inference_model": "gpt2",
    "dataset_id": "svf-training-isolated"
  },
  "backend_bindings": [
    {
      "binding_id": "training-manager.ipfs_accelerate_py.run_owner_task",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/owner_execution",
        "operator": "equals",
        "expected": {
          "checkpoint": "bafkreifxybxu6epuydfeii2cdem53kozrxdomlvdth3gx7n753332itfbq",
          "dataset_id": "svf-training-isolated",
          "model_id": "gpt2",
          "output": "dataset svf-training-isolated model gpt2-",
          "queue_transitions": [
            {"order": 1, "status": "queued"},
            {"order": 2, "status": "running"},
            {"order": 3, "status": "completed"}
          ],
          "status": "completed"
        }
      }
    },
    {
      "binding_id": "training-manager.ipfs_accelerate_py.inspect_job_state",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/checkpoint",
        "operator": "equals",
        "expected": "bafkreifxybxu6epuydfeii2cdem53kozrxdomlvdth3gx7n753332itfbq"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "fill",
        "selector": "#training-dataset-id",
        "value": "svf-training-isolated"
      },
      {
        "op": "fill",
        "selector": "#training-model-id",
        "value": "gpt2"
      },
      {
        "op": "click",
        "selector": "#launch-governed-training"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.run_owner_task\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.run_owner_task\"]"
      },
      {
        "op": "wait_for",
        "selector": "#training-owner-job[data-queue-stage=\"1\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "json_attribute",
          "selector": "#training-owner-job",
          "attribute": "data-queue-progress",
          "pointer": "/stage",
          "temporal_ms": 1000
        },
        "operator": "at_least",
        "expected": 1
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "click",
        "selector": "#read-owner-job"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.inspect_job_state\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.inspect_job_state\"]"
      },
      {
        "op": "wait_for",
        "selector": "#training-reopened-record[data-reopened=\"read\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "#training-model-id",
        "key": "Enter"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "backend_result",
          "binding_id": "training-manager.ipfs_accelerate_py.inspect_job_state",
          "pointer": "/result/result/result/persisted_selection"
        },
        "operator": "equals",
        "expected": {
          "dataset_id": "svf-training-isolated",
          "model_id": "gpt2"
        }
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "#training-dataset-id",
        "value": "invalid"
      },
      {
        "op": "press",
        "selector": "#training-dataset-id",
        "key": "Enter"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#training-config-error"
        },
        "operator": "contains",
        "expected": "Invalid data"
      },
      {
        "op": "fill",
        "selector": "#training-dataset-id",
        "value": "svf-training-isolated"
      },
      {
        "op": "fill",
        "selector": "#training-model-id",
        "value": "gpt2"
      },
      {
        "op": "click",
        "selector": "#retry-bounded-owner"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.run_owner_task\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"training-manager.ipfs_accelerate_py.run_owner_task\"]"
      },
      {
        "op": "wait_for",
        "selector": "#training-owner-job[data-recovery-ready=\"1\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "backend_result",
          "binding_id": "training-manager.ipfs_accelerate_py.run_owner_task",
          "pointer": "/result/result/result/bounded_recovery"
        },
        "operator": "equals",
        "expected": {
          "corrected_from": "invalid",
          "dataset_id": "svf-training-isolated",
          "model_id": "gpt2",
          "output_limit": 1,
          "status": "completed"
        }
      }
    ]
  }
}
