{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "strudel-ai-daw",
  "description": "Edit a local Strudel pattern, undo back to it, save, reopen, then record one unavailable assistance request and keep composing.",
  "fixture_scope": "svf-strudel-ai-daw-local",
  "backend_bindings": [],
  "phases": {
    "primary_result": [
      {
        "op": "fill",
        "selector": "#strudel-code-editor",
        "value": "note(\"c3 e3 g3\").sound(\"sine\").cpm(120)"
      },
      {
        "op": "fill",
        "selector": "#bpm-input",
        "value": "132"
      },
      {
        "op": "click",
        "selector": "#new-pattern"
      },
      {
        "op": "assert",
        "probe": {"kind": "value", "selector": "#strudel-code-editor"},
        "operator": "contains",
        "expected": "note(\"c2 ~ c2 ~\")"
      },
      {
        "op": "click",
        "selector": "#undo-btn"
      },
      {
        "op": "assert",
        "probe": {"kind": "value", "selector": "#strudel-code-editor"},
        "operator": "equals",
        "expected": "note(\"c3 e3 g3\").sound(\"sine\").cpm(120)"
      },
      {
        "op": "assert",
        "probe": {"kind": "value", "selector": "#bpm-input"},
        "operator": "equals",
        "expected": "132"
      },
      {
        "op": "click",
        "selector": "#play-btn"
      },
      {
        "op": "wait_for",
        "selector": "#transport-started",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {"kind": "text", "selector": "#transport-started"},
        "operator": "contains",
        "expected": "Play started the local reference tone."
      },
      {
        "op": "click",
        "selector": "#stop-btn"
      },
      {
        "op": "wait_for",
        "selector": "#transport-halted",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {"kind": "text", "selector": "#transport-halted"},
        "operator": "equals",
        "expected": "Stop halted the local reference tone."
      },
      {
        "op": "press",
        "selector": "#strudel-code-editor",
        "key": "Control+s"
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "text",
          "selector": "#project-retention"
        },
        "operator": "equals",
        "expected": "Undo applied from the local history stack. Restored reason new-pattern, active pattern main, tempo 132, and editable code note(\"c3 e3 g3\").sound(\"sine\").cpm(120)."
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "text",
          "selector": "#project-retention"
        },
        "operator": "equals",
        "expected": "track:main tempo:132 source:note(\"c3 e3 g3\").sound(\"sine\").cpm(120)"
      },
      {
        "op": "assert",
        "probe": {"kind": "value", "selector": "#strudel-code-editor"},
        "operator": "equals",
        "expected": "note(\"c3 e3 g3\").sound(\"sine\").cpm(120)"
      },
      {
        "op": "assert",
        "probe": {"kind": "value", "selector": "#bpm-input"},
        "operator": "equals",
        "expected": "132"
      },
      {
        "op": "assert",
        "probe": {"kind": "text", "selector": "#transport-started"},
        "operator": "equals",
        "expected": "Play started the local reference tone. Strudel code compilation stayed unavailable."
      }
    ],
    "failure_recovery": [
      {
        "op": "click",
        "selector": "#ai-generate"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#assistance-status"
        },
        "operator": "contains",
        "expected": "not executed"
      },
      {
        "op": "fill",
        "selector": "#strudel-code-editor",
        "value": "note(\"d3 f3 a3\").sound(\"sine\").cpm(120)"
      },
      {
        "op": "press",
        "selector": "#bpm-input",
        "key": "Escape"
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "value",
          "selector": "#strudel-code-editor"
        },
        "operator": "equals",
        "expected": "note(\"d3 f3 a3\").sound(\"sine\").cpm(120)"
      }
    ]
  }
}
