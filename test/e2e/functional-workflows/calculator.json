{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "calculator",
  "description": "Browser-local 12.5 times 4, reopen that history, then divide by zero, clear, record one long result, and calculate 6 times 7.",
  "fixture_scope": "svf-calculator-372",
  "backend_bindings": [],
  "phases": {
    "primary_result": [
      {"op": "click", "selector": ".calc-btn[data-value=\"1\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"2\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"decimal\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"5\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"multiply\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"4\"]"},
      {"op": "press", "selector": ".calc-btn[data-action=\"equals\"]", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#display-primary"}, "operator": "equals", "expected": "50"}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "click", "selector": "#history-btn"},
      {"op": "wait_for", "selector": ".history-item", "state": "visible", "timeout_ms": 5000},
      {"op": "click", "selector": ".history-item"},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#display-secondary"}, "operator": "equals", "expected": "12.5 × 4"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#calculator-restored-history"}, "operator": "equals", "expected": "12.5 × 4 = 50"}
    ],
    "failure_recovery": [
      {"op": "click", "selector": ".calc-btn[data-value=\"8\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"divide\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"0\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"equals\"]"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#display-error"}, "operator": "contains", "expected": "zero"},
      {"op": "click", "selector": ".calc-btn[data-action=\"backspace\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"clear\"]"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#display-error"}, "operator": "equals", "expected": ""},
      {"op": "click", "selector": ".calc-btn[data-value=\"1\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"2\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"3\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"4\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"5\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"6\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"7\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"8\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"9\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"multiply\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"1\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"equals\"]"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#calculator-long-result"}, "operator": "equals", "expected": "123456789"},
      {"op": "click", "selector": ".calc-btn[data-value=\"6\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"multiply\"]"},
      {"op": "click", "selector": ".calc-btn[data-value=\"7\"]"},
      {"op": "click", "selector": ".calc-btn[data-action=\"equals\"]"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "text", "selector": "#display-primary"}, "operator": "equals", "expected": "42"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#calculator-restored-history"}, "operator": "equals", "expected": "12.5 × 4 = 50"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#calculator-long-result"}, "operator": "equals", "expected": "123456789"}
    ]
  }
}
