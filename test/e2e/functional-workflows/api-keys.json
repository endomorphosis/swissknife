{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "api-keys",
  "description": "Save one disposable opaque reference and keep Python-owner dispatch policy-blocked.",
  "fixture_scope": "svf-api-keys-opaque-ref",
  "backend_bindings": [],
  "phases": {
    "primary_result": [
      {"op": "fill", "selector": "#svf-ref-label", "value": "Local disposable"},
      {"op": "fill", "selector": "#svf-ref-value", "value": "ref-local-opaque"},
      {"op": "press", "selector": "#svf-ref-value", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#svf-ref-status"}, "operator": "contains", "expected": "Credential values are absent"}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#svf-ref-saved"}, "operator": "equals", "expected": "ref-local-opaque"}
    ],
    "failure_recovery": [
      {"op": "fill", "selector": "#svf-ref-value", "value": "not-a-reference"},
      {"op": "press", "selector": "#svf-ref-value", "key": "Enter"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#svf-ref-guidance"}, "operator": "contains", "expected": "policy"},
      {"op": "click", "selector": "#svf-ref-retain"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "text", "selector": "#svf-ref-guidance"}, "operator": "contains", "expected": "blocked"}
    ]
  }
}
