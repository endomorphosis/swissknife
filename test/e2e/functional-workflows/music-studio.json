{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "music-studio",
  "description": "Classic local project with one track edit, tempo, instrument, save, reopen, and invalid-project recovery.",
  "fixture_scope": "svf-music-studio-classic",
  "backend_bindings": [],
  "phases": {
    "primary_result": [
      {"op": "wait_for", "selector": "#classic-track-name", "state": "visible", "timeout_ms": 5000},
      {"op": "fill", "selector": "#classic-track-name", "value": "Midnight Lead"},
      {"op": "fill", "selector": "#classic-tempo", "value": "96"},
      {"op": "select", "selector": "#classic-instrument", "value": "lead"},
      {"op": "click", "selector": "#classic-play"},
      {"op": "click", "selector": "#classic-stop"},
      {"op": "click", "selector": "#classic-save"},
      {"op": "press", "selector": "#classic-track-name", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#music-studio-workflow-status"}, "operator": "equals", "expected": "Local classic project ready. No remote render."}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#classic-reopen-summary"}, "operator": "equals", "expected": "Midnight Lead | 96 | lead"}
    ],
    "failure_recovery": [
      {"op": "click", "selector": "details.studio-diagnostics summary"},
      {"op": "fill", "selector": "#classic-project-json", "value": "{"},
      {"op": "click", "selector": "#classic-open-project"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#music-studio-recovery"}, "operator": "contains", "expected": "Invalid project"},
      {"op": "fill", "selector": "#classic-project-json", "value": "{\"schema\":\"swissknife.music-studio.classic-project.v1\",\"track_name\":\"Midnight Lead\",\"tempo\":96,\"instrument\":\"lead\"}"},
      {"op": "click", "selector": "#classic-open-project"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "value", "selector": "#classic-track-name"}, "operator": "equals", "expected": "Midnight Lead"}
    ]
  }
}
