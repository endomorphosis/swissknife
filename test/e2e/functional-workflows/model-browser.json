{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "model-browser",
  "description": "Refresh the actual native model catalog, select its supported gpt2 model and run a bounded prompt. Reopen the saved output, reject an unknown model without dispatch, then run the supported model again.",
  "fixture_scope": "svf-model-browser-primary",
  "backend_bindings": [
    {
      "binding_id": "model-browser.ipfs_accelerate_py.inspect_model_catalog",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/status",
        "operator": "equals",
        "expected": "completed"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "click",
        "selector": "#refresh-models"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "[data-model-id=\"gpt2\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-model-id=\"gpt2\"]"
      },
      {
        "op": "fill",
        "selector": "#model-test-prompt",
        "value": "ping"
      },
      {
        "op": "press",
        "selector": "#model-test-prompt",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#model-run-status[data-run-state=\"completed\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "text",
          "selector": "#model-run-status"
        },
        "operator": "equals",
        "expected": "Run status: completed"
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "text",
          "selector": "#model-run-history"
        },
        "operator": "contains",
        "expected": "gpt2 | ping"
      }
    ],
    "failure_recovery": [
      {
        "op": "click",
        "selector": "#refresh-models"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "[data-model-id=\"gpt2\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-model-id=\"gpt2\"]"
      },
      {
        "op": "fill",
        "selector": "#model-test-model-id",
        "value": "unavailable-svf-model"
      },
      {
        "op": "fill",
        "selector": "#model-test-prompt",
        "value": "ping"
      },
      {
        "op": "click",
        "selector": "#run-model-test"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#model-run-status"
        },
        "operator": "contains",
        "expected": "unsupported model"
      },
      {
        "op": "fill",
        "selector": "#model-test-model-id",
        "value": "gpt2"
      },
      {
        "op": "press",
        "selector": "#model-test-prompt",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"model-browser.ipfs_accelerate_py.inspect_model_catalog\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#model-run-status[data-run-state=\"completed\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "text",
          "selector": "#model-run-status"
        },
        "operator": "equals",
        "expected": "Run status: completed"
      }
    ]
  }
}
