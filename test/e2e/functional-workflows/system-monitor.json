{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "system-monitor",
  "description": "Refresh measured telemetry through the declared inspect_telemetry binding, reopen the saved sample as retained history, record the owner rejection of an unsupported observation argument without a new sample, then confirm a second refresh that records a newer sample. Policy and help text are not the error.",
  "fixture_scope": "svf-system-monitor-live",
  "backend_bindings": [
    {
      "binding_id": "system-monitor.ipfs_accelerate_py.inspect_telemetry",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/utilization",
        "operator": "not_equals",
        "expected": null
      }
    }
  ],
  "phases": {
    "primary_result": [
      {"op": "click", "selector": "#refresh-backend-telemetry"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]"},
      {"op": "wait_for", "selector": "#cpu-metric:has-text(\"%\")", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "#expand-cpu-history"},
      {"op": "press", "selector": "#expand-cpu-history", "key": "ArrowDown"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#cpu-metric"}, "operator": "not_equals", "expected": "n/a"}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "click", "selector": "#refresh-backend-telemetry"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]"},
      {"op": "wait_for", "selector": "#cpu-series-caption:has-text(\"fresh\")", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "#expand-cpu-history"},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#cpu-series-caption"}, "operator": "contains", "expected": "fresh"}
    ],
    "failure_recovery": [
      {"op": "click", "selector": "#probe-unsupported-observation"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]"},
      {"op": "wait_for", "selector": "#owner-failure-status:has-text(\"unavailable\")", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#owner-failure-status"}, "operator": "contains", "expected": "unavailable"},
      {"op": "click", "selector": "#refresh-backend-telemetry"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"system-monitor.ipfs_accelerate_py.inspect_telemetry\"]"},
      {"op": "wait_for", "selector": "#owner-failure-status:has-text(\"fresh measured\")", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "#expand-cpu-history"},
      {"op": "press", "selector": "#expand-cpu-history", "key": "ArrowDown"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "text", "selector": "#owner-failure-status"}, "operator": "contains", "expected": "fresh measured"}
    ]
  }
}
