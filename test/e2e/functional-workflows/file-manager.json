      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "mode": "isolated_mutation",
      "result_assertion": {
        "expected": "7a26ef347543682dfee955176f6f81987c0b2a5503908035387eaca387b18817",
        "operator": "equals",
        "pointer": "/result/result/content/0/json/sha256"
