{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "accelerate-panel",
  "description": "Run one bounded accelerate-panel inference, reopen that saved run, reread its execution record, and read CPU hardware fit. An empty input keeps its model id, cancel reports that no cancellation exists, and a supported model and input are submitted again.",
  "fixture_scope": "svf-accelerate-panel-run",
  "backend_bindings": [
    {
      "binding_id": "accelerate-panel.ipfs_accelerate_py.run_inference_job",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 120,
      "max_output_bytes": 262144,
      "result_assertion": {
        "pointer": "/result/result/result/output",
        "operator": "contains",
        "expected": "short test"
      }
    },
    {
      "binding_id": "accelerate-panel.ipfs_accelerate_py.read_job_status",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 262144,
      "result_assertion": {
        "pointer": "/result/result/result/read_from_execution_record",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "binding_id": "accelerate-panel.ipfs_accelerate_py.read_hardware_profile",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 262144,
      "result_assertion": {
        "pointer": "/result/result/result/device",
        "operator": "equals",
        "expected": "cpu"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "fill",
        "selector": "#accelerate-model-id",
        "value": "gpt2"
      },
      {
        "op": "fill",
        "selector": "#accelerate-prompt",
        "value": "short test"
      },
      {
        "op": "click",
        "selector": "[data-action=\"run-primary-inference\"]"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"accelerate-panel.ipfs_accelerate_py.run_inference_job\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"accelerate-panel.ipfs_accelerate_py.run_inference_job\"]"
      },
      {
        "op": "wait_ms",
        "milliseconds": 5000
      },
      {
        "op": "wait_for",
        "selector": "#accelerate-progress-label:has-text(\"completed\")",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "#accelerate-model-id",
        "key": "Enter"
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-output"
        },
        "operator": "contains",
        "expected": "short test"
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#accelerate-model-id"
        },
        "operator": "equals",
        "expected": "gpt2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#accelerate-prompt"
        },
        "operator": "equals",
        "expected": "short test"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-output"
        },
        "operator": "contains",
        "expected": "short test"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-run-record"
        },
        "operator": "contains",
        "expected": "Saved run model=gpt2; state=completed; finished="
      },
      {
        "op": "click",
        "selector": "[data-action=\"read-job-status\"]"
      },
      {
        "op": "wait_for",
        "selector": "#accelerate-queue-status:has-text(\"job_status completed\")",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-queue-status"
        },
        "operator": "contains",
        "expected": "job_status completed"
      },
      {
        "op": "click",
        "selector": "[data-action=\"refresh-hardware\"]"
      },
      {
        "op": "wait_for",
        "selector": "#accelerate-hardware-status:has-text(\"hardware_profile executed\")",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-hardware-status"
        },
        "operator": "contains",
        "expected": "hardware_profile executed"
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "#accelerate-model-id",
        "value": "unsupported-model-svf-132"
      },
      {
        "op": "fill",
        "selector": "#accelerate-prompt",
        "value": ""
      },
      {
        "op": "click",
        "selector": "[data-action=\"run-primary-inference\"]"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-error-status"
        },
        "operator": "contains",
        "expected": "Model ID kept: unsupported-model-svf-132"
      },
      {
        "op": "click",
        "selector": "[data-action=\"cancel-job\"]"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-queue-status"
        },
        "operator": "contains",
        "expected": "Nothing was cancelled."
      },
      {
        "op": "fill",
        "selector": "#accelerate-model-id",
        "value": "gpt2"
      },
      {
        "op": "fill",
        "selector": "#accelerate-prompt",
        "value": "short test"
      },
      {
        "op": "click",
        "selector": "[data-action=\"run-primary-inference\"]"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"accelerate-panel.ipfs_accelerate_py.run_inference_job\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"accelerate-panel.ipfs_accelerate_py.run_inference_job\"]"
      },
      {
        "op": "wait_ms",
        "milliseconds": 5000
      },
      {
        "op": "wait_for",
        "selector": "#accelerate-progress-label:has-text(\"completed\")",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "text",
          "selector": "#accelerate-output"
        },
        "operator": "contains",
        "expected": "short test"
      }
    ]
  }
}
