{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "p2p-chat-unified",
  "description": "Send one exact message to the online peer through the governed publish binding, reopen the stored thread, then keep one offline-peer message queued and retry it without a second copy.",
  "fixture_scope": "svf-p2p-chat-g030",
  "backend_bindings": [
    {
      "binding_id": "p2p-chat-unified.ipfs_kit_py.exchange_peer_messages",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/delivery_state",
        "operator": "equals",
        "expected": "delivered"
      }
    },
    {
      "binding_id": "p2p-chat-unified.ipfs_kit_py.persist_artifact",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/kind",
        "operator": "equals",
        "expected": "svf-p2p-342-hello peer-alice-g030 delivered"
      }
    },
    {
      "binding_id": "p2p-chat-unified.ipfs_kit_py.retrieve_artifact",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/cid",
        "operator": "equals",
        "expected": "bafkreidugqqicukt3ydilpuq5i3b6463xrlh7zmd6npzp4zi7v2bpo5pp4"
      }
    },
    {
      "binding_id": "p2p-chat-unified.ipfs_datasets_py.record_provenance",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/destination",
        "operator": "equals",
        "expected": "/tmp/svf-p2p-342-offline-peer-bob-g030.json"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {"op": "click", "selector": "[data-peer-id=\"peer-alice-g030\"]"},
      {"op": "fill", "selector": "[data-chat-draft]", "value": "svf-p2p-342-hello"},
      {"op": "click", "selector": ".send-button"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_kit_py.exchange_peer_messages\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_kit_py.exchange_peer_messages\"]"},
      {"op": "wait_for", "selector": ".messages-container .message[data-pubsub-acknowledged=\"true\"] .message-text", "state": "visible", "timeout_ms": 15000},
      {"op": "press", "selector": "[data-chat-draft]", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": ".messages-container .message:last-child .message-text"}, "operator": "equals", "expected": "svf-p2p-342-hello"},
      {"op": "assert", "probe": {"kind": "value", "selector": "#p2p-selected-peer"}, "operator": "equals", "expected": "peer-alice-g030"},
      {"op": "assert", "probe": {"kind": "text", "selector": ".messages-container .message:last-child .message-meta"}, "operator": "equals", "expected": "Alice · delivered"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_kit_py.persist_artifact\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_kit_py.persist_artifact\"]"},
      {"op": "wait_for", "selector": "#p2p-reload-stored[data-stored-kind=\"svf-p2p-342-hello peer-alice-g030 delivered\"]", "state": "visible", "timeout_ms": 15000}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "wait_for", "selector": "#p2p-selected-peer", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "#p2p-reload-stored"},
      {"op": "wait_for", "selector": "#p2p-reload-stored[data-stored-verified=\"reloaded\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "probe": {"kind": "value", "selector": "#p2p-selected-peer"}, "operator": "equals", "expected": "peer-alice-g030"},
      {"op": "assert", "probe": {"kind": "text", "selector": ".messages-container .message:last-child .message-meta"}, "operator": "equals", "expected": "Alice · delivered"},
      {"op": "assert", "probe": {"kind": "text", "selector": ".messages-container .message:last-child .message-text"}, "operator": "equals", "expected": "svf-p2p-342-hello"},
      {"op": "press", "selector": "[data-chat-draft]", "key": "Tab"},
      {"op": "press", "selector": "[data-chat-draft]", "key": "Shift+Tab"},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "backend_result", "binding_id": "p2p-chat-unified.ipfs_kit_py.retrieve_artifact", "pointer": "/result/result/content/0/json/metadata/kind"}, "operator": "equals", "expected": "svf-p2p-342-hello peer-alice-g030 delivered"}
    ],
    "failure_recovery": [
      {"op": "click", "selector": "[data-peer-id=\"peer-bob-g030\"]"},
      {"op": "fill", "selector": "[data-chat-draft]", "value": "svf-p2p-342-offline"},
      {"op": "click", "selector": ".send-button"},
      {"op": "wait_for", "selector": "#p2p-offline-status[data-offline-state=\"queued\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#p2p-offline-status"}, "operator": "equals", "expected": "Offline: svf-p2p-342-offline is queued and not delivered."},
      {"op": "select", "selector": "#p2p-retained-offline", "value": "svf-p2p-342-offline"},
      {"op": "click", "selector": "[data-chat-action=\"recover-offline\"]"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_datasets_py.record_provenance\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_datasets_py.record_provenance\"]"},
      {"op": "wait_for", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_kit_py.exchange_peer_messages\"]", "state": "visible", "timeout_ms": 15000},
      {"op": "click", "selector": "[data-gateway-confirm=\"p2p-chat-unified.ipfs_kit_py.exchange_peer_messages\"]"},
      {"op": "wait_for", "selector": ".messages-container .message:last-child[data-pubsub-acknowledged=\"true\"] .message-text", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "probe": {"kind": "text", "selector": ".messages-container .message:last-child .message-text"}, "operator": "equals", "expected": "svf-p2p-342-offline"},
      {"op": "assert", "probe": {"kind": "text", "selector": ".messages-container .message:last-child .message-meta"}, "operator": "equals", "expected": "Bob · delivered"},
      {"op": "assert", "probe": {"kind": "value", "selector": "[data-chat-draft]"}, "operator": "equals", "expected": ""},
      {"op": "press", "selector": "[data-chat-draft]", "key": "Escape"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "json_attribute", "selector": ".messages-container", "attribute": "data-message-count"}, "operator": "equals", "expected": {"count": 1, "peer": "peer-bob-g030", "text": "svf-p2p-342-offline"}}
    ]
  }
}
