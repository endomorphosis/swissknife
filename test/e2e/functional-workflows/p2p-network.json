{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "p2p-network",
  "description": "Refresh owner peer state, reopen, then recover from an unavailable transport.",
  "fixture_scope": "svf-p2p-network-332",
  "backend_bindings": [
    {
      "binding_id": "p2p-network.ipfs_kit_py.inspect_peer_network",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/Peers",
        "operator": "equals",
        "expected": []
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "wait_for",
        "selector": "#p2p-swarm-status",
        "state": "visible",
        "timeout_ms": 5000
      },
      {
        "op": "press",
        "selector": "#p2p-refresh-swarm",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#p2p-swarm-settled",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "json_attribute",
          "selector": "#p2p-swarm-status",
          "attribute": "data-owner-states"
        },
        "operator": "equals",
        "expected": {
          "connected_peers": 0,
          "swarm": "empty"
        }
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "click",
        "selector": "#p2p-apply-transport"
      },
      {
        "op": "wait_for",
        "selector": "[data-swarm-state-card=\"known\"].is-current",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "#p2p-apply-transport",
        "key": "Tab"
      },
      {
        "op": "press",
        "selector": "#p2p-apply-transport",
        "key": "Shift+Tab"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "backend_result",
          "binding_id": "p2p-network.ipfs_kit_py.inspect_peer_network",
          "pointer": "/result/result/content/0/json/ID"
        },
        "operator": "equals",
        "expected": "12D3KooWMD4WLAv4DhhEdb1SKVXhExTjcE7cmqu16gcyfqFAMgQK"
      },
      {
        "op": "click",
        "selector": "#p2p-refresh-swarm"
      },
      {
        "op": "wait_for",
        "selector": "#p2p-swarm-settled",
        "state": "visible",
        "timeout_ms": 15000
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "#p2p-transport-input",
        "value": "offline"
      },
      {
        "op": "click",
        "selector": "#p2p-apply-transport"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#p2p-swarm-status"
        },
        "operator": "contains",
        "expected": "unavailable"
      },
      {
        "op": "fill",
        "selector": "#p2p-transport-input",
        "value": "http"
      },
      {
        "op": "click",
        "selector": "#p2p-refresh-swarm"
      },
      {
        "op": "wait_for",
        "selector": "#p2p-swarm-settled",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "#p2p-transport-input",
        "key": "Escape"
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "backend_result",
          "binding_id": "p2p-network.ipfs_kit_py.inspect_peer_network",
          "pointer": "/result/result/content/0/json/native_provenance/observed_at"
        },
        "operator": "not_equals",
        "expected": ""
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#p2p-transport-recovery"
        },
        "operator": "equals",
        "expected": "Transport was unavailable. No peers were invented. Reconnected on http and refreshed the owner."
      }
    ]
  }
}
