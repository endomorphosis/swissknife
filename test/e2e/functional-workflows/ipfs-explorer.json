{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "ipfs-explorer",
  "description": "Retrieve the CID already shown in Quick Access through the declared kit binding, reopen the verified preview, then reject an invalid CID without replacing that preview.",
  "fixture_scope": "svf-ipfs-explorer",
  "backend_bindings": [
    {
      "binding_id": "ipfs-explorer.ipfs_kit_py.retrieve_content",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 262144,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/sha256",
        "operator": "equals",
        "expected": "2e166159b39f8b36fcfefaf97e894728f38c518f10a3bb044adc2cce93a31313"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "wait_for",
        "selector": "#path-input",
        "state": "visible",
        "timeout_ms": 8000
      },
      {
        "op": "fill",
        "selector": "#path-input",
        "value": "bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm"
      },
      {
        "op": "click",
        "selector": "#go-btn"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"ipfs-explorer.ipfs_kit_py.retrieve_content\"]",
        "state": "visible",
        "timeout_ms": 8000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"ipfs-explorer.ipfs_kit_py.retrieve_content\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#content-browser [data-retrieved-cid=\"bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "text",
          "selector": "#content-browser"
        },
        "operator": "contains",
        "expected": "Pin state for bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm: owner retrieve omitted the pin field."
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-content-sha256"
        },
        "operator": "equals",
        "expected": "Content sha256 2e166159b39f8b36fcfefaf97e894728f38c518f10a3bb044adc2cce93a31313"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-owner-host"
        },
        "operator": "equals",
        "expected": "Owner host http://127.0.0.1:5031"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-byte-length"
        },
        "operator": "equals",
        "expected": "Retrieved payload length 184."
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "wait_for",
        "selector": "#path-input",
        "state": "visible",
        "timeout_ms": 8000
      },
      {
        "op": "fill",
        "selector": "#path-input",
        "value": "bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm"
      },
      {
        "op": "click",
        "selector": "#go-btn"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"ipfs-explorer.ipfs_kit_py.retrieve_content\"]",
        "state": "visible",
        "timeout_ms": 8000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"ipfs-explorer.ipfs_kit_py.retrieve_content\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#ipfs-byte-compare",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "backend_result",
          "binding_id": "ipfs-explorer.ipfs_kit_py.retrieve_content",
          "pointer": "/result/result/content/0/json/sha256"
        },
        "operator": "equals",
        "expected": "2e166159b39f8b36fcfefaf97e894728f38c518f10a3bb044adc2cce93a31313"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-byte-compare"
        },
        "operator": "equals",
        "expected": "Stored preview sha256 matches this retrieve. Length 184."
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-content-sha256"
        },
        "operator": "equals",
        "expected": "Content sha256 2e166159b39f8b36fcfefaf97e894728f38c518f10a3bb044adc2cce93a31313"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-byte-length"
        },
        "operator": "equals",
        "expected": "Retrieved payload length 184."
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "#path-input",
        "value": "not-a-cid"
      },
      {
        "op": "press",
        "selector": "#path-input",
        "key": "Enter"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": ".ipfs-error-banner"
        },
        "operator": "contains",
        "expected": "Invalid or absent CID"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-content-sha256"
        },
        "operator": "equals",
        "expected": "Content sha256 2e166159b39f8b36fcfefaf97e894728f38c518f10a3bb044adc2cce93a31313"
      },
      {
        "op": "fill",
        "selector": "#path-input",
        "value": "bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm"
      },
      {
        "op": "click",
        "selector": "#go-btn"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm=\"ipfs-explorer.ipfs_kit_py.retrieve_content\"]",
        "state": "visible",
        "timeout_ms": 8000
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"ipfs-explorer.ipfs_kit_py.retrieve_content\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#ipfs-retry-compare",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "backend_result",
          "binding_id": "ipfs-explorer.ipfs_kit_py.retrieve_content",
          "pointer": "/result/result/content/0/json/size"
        },
        "operator": "equals",
        "expected": 184
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#ipfs-retry-compare"
        },
        "operator": "equals",
        "expected": "Retry retrieve sha256 matches the stored preview. Length 184."
      }
    ]
  }
}
