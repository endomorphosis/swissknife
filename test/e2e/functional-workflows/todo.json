{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "todo",
  "description": "Create two local tasks with one dependency, edit and complete the first, reopen, then recover from an empty title.",
  "fixture_scope": "svf-todo-local-tasks",
  "backend_bindings": [],
  "phases": {
    "primary_result": [
      {"op": "fill", "selector": ".new-todo-input", "value": "Alpha draft"},
      {"op": "click", "selector": ".add-todo-btn"},
      {"op": "wait_for", "selector": "[data-todo-title=\"Alpha draft\"]", "state": "visible", "timeout_ms": 5000},
      {"op": "fill", "selector": ".new-todo-input", "value": "Beta follows alpha"},
      {"op": "select", "selector": ".todo-depends", "value": "Alpha draft"},
      {"op": "click", "selector": ".add-todo-btn"},
      {"op": "wait_for", "selector": "[data-todo-title=\"Beta follows alpha\"]", "state": "visible", "timeout_ms": 5000},
      {"op": "check", "selector": "[data-todo-title=\"Alpha draft\"] .todo-complete"},
      {"op": "click", "selector": "[data-todo-title=\"Alpha draft\"] .todo-edit-btn"},
      {"op": "fill", "selector": "[data-todo-title=\"Alpha draft\"] .todo-edit-input", "value": "Alpha ready"},
      {"op": "press", "selector": "[data-todo-title=\"Alpha draft\"] .todo-edit-input", "key": "Enter"},
      {"op": "wait_for", "selector": "#todo-state", "state": "visible", "timeout_ms": 5000},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": "#todo-state"}, "operator": "equals", "expected": "Tasks id 1 Alpha ready completed; id 2 Beta follows alpha open depends on id 1 Alpha ready completed. Stored in this browser only."}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "wait_for", "selector": "#todo-state:has-text(\"Reloaded id 1 Alpha ready completed\")", "state": "visible", "timeout_ms": 15000},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": "#todo-state"}, "operator": "equals", "expected": "Reloaded id 1 Alpha ready completed; id 2 Beta follows alpha open depends on id 1 Alpha ready completed. Stored in this browser only."}
    ],
    "failure_recovery": [
      {"op": "fill", "selector": ".new-todo-input", "value": "   "},
      {"op": "click", "selector": ".add-todo-btn"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": ".todo-error"}, "operator": "contains", "expected": "empty"},
      {"op": "fill", "selector": ".new-todo-input", "value": "Gamma note"},
      {"op": "click", "selector": ".add-todo-btn"},
      {"op": "wait_for", "selector": "#todo-state:has-text(\"id 3 Gamma note open\")", "state": "visible", "timeout_ms": 5000},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "text", "selector": "#todo-state"}, "operator": "equals", "expected": "Reloaded id 1 Alpha ready completed; id 2 Beta follows alpha open depends on id 1 Alpha ready completed; id 3 Gamma note open. Stored in this browser only."},
      {"op": "assert", "probe": {"kind": "text", "selector": ".todo-error"}, "operator": "equals", "expected": ""}
    ]
  }
}
