{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "image-viewer",
  "description": "Retrieve the controlled SVG through the declared binding after trusted confirmation, zoom it to 120% and rotate it 90 degrees, reopen that same decoded image, then reject a non-content CID and retrieve the known CID again. Policy and help text are not the error.",
  "fixture_scope": "svf-image-viewer-cid",
  "backend_bindings": [
    {
      "binding_id": "image-viewer.ipfs_kit_py.retrieve_content",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 262144,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/bytes_base64",
        "operator": "equals",
        "expected": "PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMjgiIGhlaWdodD0iOTYiIHZpZXdCb3g9IjAgMCAxMjggOTYiPjxyZWN0IHdpZHRoPSIxMjgiIGhlaWdodD0iOTYiIGZpbGw9IiMxNTM2NGQiLz48Y2lyY2xlIGN4PSI2NCIgY3k9IjQ4IiByPSIyOCIgZmlsbD0iI2U5YmQ1OCIvPjwvc3ZnPg=="
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "wait_for",
        "selector": "#main-image",
        "state": "visible",
        "timeout_ms": 5000
      },
      {
        "op": "fill",
        "selector": "#iv-cid-field",
        "value": "bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm"
      },
      {
        "op": "fill",
        "selector": "#iv-fixture-scope",
        "value": "svf-image-viewer-cid"
      },
      {
        "op": "check",
        "selector": "#iv-retrieve-consent"
      },
      {
        "op": "click",
        "selector": "#retrieve-cid-btn"
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"image-viewer.ipfs_kit_py.retrieve_content\"]"
      },
      {
        "op": "wait_for",
        "selector": "#main-image[data-cid=\"bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm\"][data-pixel-source=\"png\"]",
        "state": "visible",
        "timeout_ms": 10000
      },
      {
        "op": "click",
        "selector": "#zoom-in-btn"
      },
      {
        "op": "click",
        "selector": "#rotate-right-btn"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#zoom-level"
        },
        "operator": "equals",
        "expected": "120%"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#rotation-readout"
        },
        "operator": "equals",
        "expected": "90°"
      },
      {
        "op": "click",
        "selector": "#pan-demo-btn"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#pan-readout"
        },
        "operator": "equals",
        "expected": "28, -18"
      },
      {
        "op": "press",
        "selector": "#iv-cid-field",
        "key": "ArrowDown"
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "image_state",
          "selector": "#main-image",
          "pointer": "/natural_width"
        },
        "operator": "equals",
        "expected": 128
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "wait_for",
        "selector": "#main-image[data-cid=\"bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm\"][data-pixel-source=\"png\"]",
        "state": "visible",
        "timeout_ms": 5000
      },
      {
        "op": "wait_for",
        "selector": "#iv-png-sha256",
        "state": "visible",
        "timeout_ms": 5000
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#iv-png-sha256"
        },
        "operator": "equals",
        "expected": "41e51a4d2c0ee952e9e3f45add23bf14aeda19a22fa2cf6f5204485856db5cd8"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "image_state",
          "selector": "#main-image",
          "pointer": "/natural_height"
        },
        "operator": "equals",
        "expected": 96
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "#iv-cid-field",
        "value": "not-a-content-cid"
      },
      {
        "op": "fill",
        "selector": "#iv-fixture-scope",
        "value": "svf-image-viewer-cid"
      },
      {
        "op": "check",
        "selector": "#iv-retrieve-consent"
      },
      {
        "op": "click",
        "selector": "#retrieve-cid-btn"
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"image-viewer.ipfs_kit_py.retrieve_content\"]"
      },
      {
        "op": "wait_for",
        "selector": "#image-workflow-log:has-text(\"retrieval failed for not-a-content-cid\")",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#image-workflow-log"
        },
        "operator": "contains",
        "expected": "retrieval failed for not-a-content-cid"
      },
      {
        "op": "fill",
        "selector": "#iv-cid-field",
        "value": "bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm"
      },
      {
        "op": "fill",
        "selector": "#iv-fixture-scope",
        "value": "svf-image-viewer-cid"
      },
      {
        "op": "check",
        "selector": "#iv-retrieve-consent"
      },
      {
        "op": "click",
        "selector": "#retrieve-cid-btn"
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm=\"image-viewer.ipfs_kit_py.retrieve_content\"]"
      },
      {
        "op": "wait_for",
        "selector": "#main-image[data-cid=\"bafkreiboczqvtm47rm3pz7x27f7isrzi6ogfddyquo5qisw4fthjhiytcm\"][data-pixel-source=\"png\"]",
        "state": "visible",
        "timeout_ms": 10000
      },
      {
        "op": "click",
        "selector": "#zoom-in-btn"
      },
      {
        "op": "click",
        "selector": "#rotate-right-btn"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#zoom-level"
        },
        "operator": "equals",
        "expected": "120%"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#rotation-readout"
        },
        "operator": "equals",
        "expected": "90°"
      },
      {
        "op": "click",
        "selector": "#pan-demo-btn"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#pan-readout"
        },
        "operator": "equals",
        "expected": "28, -18"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#iv-recovery-note"
        },
        "operator": "equals",
        "expected": "recovered after retrieval failed for not-a-content-cid"
      },
      {
        "op": "press",
        "selector": "#iv-cid-field",
        "key": "ArrowDown"
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "image_state",
          "selector": "#main-image",
          "pointer": "/natural_width"
        },
        "operator": "equals",
        "expected": 128
      }
    ]
  }
}
