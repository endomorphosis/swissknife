{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "neural-photoshop",
  "description": "Retrieve and decode native source bytes, edit the real canvas with Undo/Redo, save an encoded PNG and editable layers, reopen matching pixels and bytes, then preserve edits across an invalid CID and a genuine valid retry.",
  "fixture_scope": "svf-neural-photoshop-442",
  "backend_bindings": [
    {
      "binding_id": "neural-photoshop.ipfs_kit_py.retrieve_content",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 1048576,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/sha256",
        "operator": "equals",
        "expected": "859106eaa81df402f7765c7698f2c35909c6a6cc1f8c01182569a1ae363e28a1"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "fill",
        "selector": "[data-source-cid-input]",
        "value": "bafkreiefsedovka56qbpo5s4o2mpfq2zbhdknta7rqarqjljugxdmpriue"
      },
      {
        "op": "click",
        "selector": "#load-source-bytes"
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"neural-photoshop.ipfs_kit_py.retrieve_content\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#main-canvas[data-source-cid=\"bafkreiefsedovka56qbpo5s4o2mpfq2zbhdknta7rqarqjljugxdmpriue\"][data-source-pixels-sha256=\"9fdb6b885b647934503a0738caad55ff72c56f47726e06b09332fd606ebafc11\"][width=\"64\"][height=\"48\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-tool=\"brush\"]"
      },
      {
        "op": "press",
        "selector": "#main-canvas",
        "key": "Enter"
      },
      {
        "op": "click",
        "selector": "#undo-btn"
      },
      {
        "op": "wait_for",
        "selector": "#project-meta[data-project-width=\"64\"][data-project-height=\"48\"][data-layer-names=\"Background\"][data-edit-action=\"Load image\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#project-meta"
        },
        "operator": "contains",
        "expected": "Load image"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "json_attribute",
          "selector": "#main-canvas",
          "attribute": "data-canvas-pixels-sha256"
        },
        "operator": "equals",
        "expected": "9fdb6b885b647934503a0738caad55ff72c56f47726e06b09332fd606ebafc11"
      },
      {
        "op": "click",
        "selector": "#redo-btn"
      },
      {
        "op": "wait_for",
        "selector": "#project-meta[data-project-width=\"64\"][data-project-height=\"48\"][data-layer-names=\"Background\"][data-edit-action=\"Brush stroke\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#project-meta"
        },
        "operator": "contains",
        "expected": "Brush stroke"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "json_attribute",
          "selector": "#main-canvas",
          "attribute": "data-canvas-pixels-sha256"
        },
        "operator": "not_equals",
        "expected": "9fdb6b885b647934503a0738caad55ff72c56f47726e06b09332fd606ebafc11"
      },
      {
        "op": "click",
        "selector": "#save-btn"
      },
      {
        "op": "wait_for",
        "selector": "[data-project-storage-state=\"saved\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "figure[data-saved-project-output] figcaption"
        },
        "operator": "contains",
        "expected": "64×48"
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "image_state",
          "selector": "[data-saved-project-image]",
          "pointer": "/natural_width"
        },
        "operator": "equals",
        "expected": 64
      }
    ],
    "persist_reopen": [
      {
        "op": "click",
        "selector": "#add-layer-btn"
      },
      {
        "op": "click",
        "selector": "#save-btn"
      },
      {
        "op": "wait_for",
        "selector": "[data-project-storage-state=\"saved\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "reopen_app"
      },
      {
        "op": "wait_for",
        "selector": "#project-meta[data-project-width=\"64\"][data-project-height=\"48\"][data-layer-names=\"Background, Layer 2\"][data-edit-action=\"Brush stroke\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "wait_for",
        "selector": "[data-project-storage-state=\"restored\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "image_state",
          "selector": "[data-saved-project-image][data-layer-names=\"Background, Layer 2\"]",
          "pointer": "/natural_width"
        },
        "operator": "equals",
        "expected": 64
      },
      {
        "op": "assert",
        "probe": {
          "kind": "json_attribute",
          "selector": "[data-saved-project-image]",
          "attribute": "data-png-bytes"
        },
        "operator": "equals",
        "expected": "1552"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "json_attribute",
          "selector": "[data-saved-project-image]",
          "attribute": "data-layer-names"
        },
        "operator": "equals",
        "expected": "Background, Layer 2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "json_attribute",
          "selector": "[data-saved-project-image]",
          "attribute": "data-png-sha256"
        },
        "operator": "equals",
        "expected": "b4b41fd8eff7b94b373b50d8ad54c5830ae696c6af5622bb8864ac5950136d33"
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "[data-source-cid-input]",
        "value": "not-a-cid"
      },
      {
        "op": "click",
        "selector": "#load-source-bytes"
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"neural-photoshop.ipfs_kit_py.retrieve_content\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "[data-source-cid-state=\"error\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "[data-source-result]"
        },
        "operator": "contains",
        "expected": "Source read failed"
      },
      {
        "op": "assert",
        "checkpoint_id": "error_image_retained",
        "retained_from": {
          "primary_result": 17,
          "persist_reopen": 6
        },
        "probe": {
          "kind": "image_state",
          "selector": "[data-saved-project-image][data-layer-names=\"Background, Layer 2\"]",
          "pointer": "/natural_width"
        },
        "operator": "equals",
        "expected": 64
      },
      {
        "op": "fill",
        "selector": "[data-source-cid-input]",
        "value": "bafkreiefsedovka56qbpo5s4o2mpfq2zbhdknta7rqarqjljugxdmpriue"
      },
      {
        "op": "click",
        "selector": "#load-source-bytes"
      },
      {
        "op": "press",
        "selector": "[data-gateway-confirm=\"neural-photoshop.ipfs_kit_py.retrieve_content\"]",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "[data-source-cid-state=\"decoded-image\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "wait_for",
        "selector": "#project-meta[data-project-width=\"64\"][data-project-height=\"48\"][data-layer-names=\"Background, Layer 2\"][data-edit-action=\"Brush stroke\"]",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "backend_result",
          "binding_id": "neural-photoshop.ipfs_kit_py.retrieve_content",
          "pointer": "/result/result/content/0/json/sha256"
        },
        "operator": "equals",
        "expected": "859106eaa81df402f7765c7698f2c35909c6a6cc1f8c01182569a1ae363e28a1"
      },
      {
        "op": "assert",
        "checkpoint_id": "recovery_image_retained",
        "retained_from": {
          "primary_result": 17,
          "persist_reopen": 6
        },
        "probe": {
          "kind": "image_state",
          "selector": "[data-saved-project-image][data-layer-names=\"Background, Layer 2\"]",
          "pointer": "/natural_width"
        },
        "operator": "equals",
        "expected": 64
      }
    ]
  }
}
