{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "navi",
  "description": "Resolve an ambiguous catalog-field query by choosing gpt2, reopen that stored target, and recover from an unresolved intent by choosing gpt2 again from those same matches.",
  "fixture_scope": "svf-navi-catalog-intent",
  "backend_bindings": [
    {
      "binding_id": "navi.ipfs_datasets_py.query_catalog",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 60,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/content",
        "operator": "contains",
        "expected": "\"id\":\"gpt2\""
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "fill",
        "selector": "#message-input",
        "value": "field g"
      },
      {
        "op": "press",
        "selector": "#message-input",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#navi-match-list",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "text",
          "selector": "#navi-match-text"
        },
        "operator": "contains",
        "expected": "gpt2 | text-generation"
      },
      {
        "op": "click",
        "selector": "#navi-choice-gpt2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#navi-selected-target"
        },
        "operator": "equals",
        "expected": "gpt2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#navi-kept-choices"
        },
        "operator": "contains",
        "expected": "gpt2 | text-generation"
      }
    ],
    "persist_reopen": [
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#navi-selected-target"
        },
        "operator": "equals",
        "expected": "gpt2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#message-input"
        },
        "operator": "equals",
        "expected": "field g"
      },
      {
        "op": "reopen_app"
      },
      {
        "op": "wait_for",
        "selector": "#navi-retained-choice",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "#message-input"
      },
      {
        "op": "click",
        "selector": "#navi-selected-target"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#message-input"
        },
        "operator": "equals",
        "expected": "field g"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "value",
          "selector": "#navi-selected-target"
        },
        "operator": "equals",
        "expected": "gpt2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#navi-retained-intent"
        },
        "operator": "equals",
        "expected": "field g"
      },
      {
        "op": "press",
        "selector": "#navi-selected-target",
        "key": "Escape"
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "text",
          "selector": "#navi-retained-choice"
        },
        "operator": "equals",
        "expected": "Selected gpt2."
      }
    ],
    "failure_recovery": [
      {
        "op": "fill",
        "selector": "#message-input",
        "value": "??"
      },
      {
        "op": "press",
        "selector": "#message-input",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#navi-intent-status",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#navi-intent-status"
        },
        "operator": "contains",
        "expected": "Not resolved"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#navi-kept-choices"
        },
        "operator": "contains",
        "expected": "gpt2 | text-generation"
      },
      {
        "op": "fill",
        "selector": "#message-input",
        "value": "field g"
      },
      {
        "op": "press",
        "selector": "#message-input",
        "key": "Enter"
      },
      {
        "op": "wait_for",
        "selector": "#navi-choice-gpt2",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "#navi-choice-gpt2"
      },
      {
        "op": "wait_for",
        "selector": "#navi-intent-status",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "#navi-selected-target",
        "key": "Escape"
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "text",
          "selector": "#navi-intent-status"
        },
        "operator": "equals",
        "expected": "Matched catalog context: gpt2."
      }
    ]
  }
}
