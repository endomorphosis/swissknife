{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "cron",
  "description": "Create a paused browser-local schedule, reopen it, add and delete a second schedule, then cancel an invalid expression without losing the first.",
  "fixture_scope": "svf-cron-local-schedule",
  "backend_bindings": [],
  "phases": {
    "primary_result": [
      {"op": "click", "selector": "#create-task"},
      {"op": "wait_for", "selector": "#task-name", "state": "visible", "timeout_ms": 5000},
      {"op": "fill", "selector": "#task-name", "value": "Morning local"},
      {"op": "fill", "selector": "#task-cron", "value": "0 9 * * *"},
      {"op": "fill", "selector": "#task-timezone", "value": "UTC"},
      {"op": "uncheck", "selector": "#task-enabled"},
      {"op": "press", "selector": "#task-cron", "key": "Enter"},
      {"op": "assert", "requirement_id": "result_1", "probe": {"kind": "text", "selector": ".task-card .next-run-text"}, "operator": "contains", "expected": "Paused · Next:"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#total-tasks"}, "operator": "equals", "expected": "1"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#paused-tasks"}, "operator": "equals", "expected": "1"}
    ],
    "persist_reopen": [
      {"op": "reopen_app"},
      {"op": "wait_for", "selector": ".task-card .task-name", "state": "visible", "timeout_ms": 5000},
      {"op": "assert", "requirement_id": "persist_reopen", "probe": {"kind": "text", "selector": ".task-card .task-name"}, "operator": "equals", "expected": "Morning local"},
      {"op": "click", "selector": "#create-task"},
      {"op": "wait_for", "selector": "#task-name", "state": "visible", "timeout_ms": 5000},
      {"op": "fill", "selector": "#task-name", "value": "Extra local"},
      {"op": "fill", "selector": "#task-cron", "value": "0 10 * * *"},
      {"op": "fill", "selector": "#task-timezone", "value": "UTC"},
      {"op": "click", "selector": "#submit-task"}
    ],
    "failure_recovery": [
      {"op": "click", "selector": "#create-task"},
      {"op": "wait_for", "selector": "#task-name", "state": "visible", "timeout_ms": 5000},
      {"op": "fill", "selector": "#task-name", "value": "Broken local"},
      {"op": "fill", "selector": "#task-cron", "value": "99 99 * * *"},
      {"op": "fill", "selector": "#task-timezone", "value": "UTC"},
      {"op": "click", "selector": "#submit-task"},
      {"op": "assert", "checkpoint_id": "error_observed", "probe": {"kind": "text", "selector": "#task-schedule-error"}, "operator": "contains", "expected": "Invalid schedule"},
      {"op": "click", "selector": "#cancel-task"},
      {"op": "click", "selector": "button[data-cron-action=\"delete\"][data-task-name=\"Extra local\"]"},
      {"op": "press", "selector": "#confirm-delete-task", "key": "Enter"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#total-tasks"}, "operator": "equals", "expected": "1"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#paused-tasks"}, "operator": "equals", "expected": "1"},
      {"op": "assert", "probe": {"kind": "text", "selector": "#scheduled-tasks-container"}, "operator": "contains", "expected": "Morning local"},
      {"op": "assert", "requirement_id": "failure_recovery", "probe": {"kind": "text", "selector": "#cron-retention"}, "operator": "equals", "expected": "Invalid schedule canceled. The bad expression was not saved. Deleted Extra local. That schedule is absent. Morning local remains."}
    ]
  }
}
