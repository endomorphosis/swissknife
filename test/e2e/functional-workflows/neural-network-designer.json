{
  "schema": "swissknife.visual-functional-scenario.v1",
  "app_id": "neural-network-designer",
  "description": "Load a three-node graph with one shape-incompatible edge, persist it, reject compile, retrieve it after reopen, remove that edge, then persist and retrieve the corrected graph.",
  "fixture_scope": "svf-nnd-shape-352",
  "backend_bindings": [
    {
      "binding_id": "neural-network-designer.ipfs_accelerate_py.read_model_catalog",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/models/0/id",
        "operator": "equals",
        "expected": "gpt2"
      }
    },
    {
      "binding_id": "neural-network-designer.ipfs_kit_py.persist_artifact",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/kind",
        "operator": "contains",
        "expected": "layers "
      }
    },
    {
      "binding_id": "neural-network-designer.ipfs_kit_py.retrieve_artifact",
      "mode": "read",
      "consent": "not_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/content/0/json/cid",
        "operator": "not_equals",
        "expected": "absent"
      }
    },
    {
      "binding_id": "neural-network-designer.ipfs_accelerate_py.run_inference_job",
      "mode": "isolated_mutation",
      "consent": "ui_required",
      "max_duration_seconds": 30,
      "max_output_bytes": 65536,
      "result_assertion": {
        "pointer": "/result/result/result/run_proof",
        "operator": "contains",
        "expected": "layers nnd-in,nnd-hidden,nnd-out edges nnd-e1,nnd-e2 params 4,2,2"
      }
    }
  ],
  "phases": {
    "primary_result": [
      {
        "op": "click",
        "selector": "#nnd-load-fixture"
      },
      {
        "op": "fill",
        "selector": "#nnd-fixture-scope",
        "value": "svf-nnd-shape-352"
      },
      {
        "op": "click",
        "selector": "#nnd-read-catalog"
      },
      {
        "op": "click",
        "selector": ".workflow-primary"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm='neural-network-designer.ipfs_kit_py.persist_artifact']",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm='neural-network-designer.ipfs_kit_py.persist_artifact']"
      },
      {
        "op": "wait_for",
        "selector": "#nnd-persist-ready",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "press",
        "selector": "#nnd-graph-label",
        "key": "Enter"
      },
      {
        "op": "assert",
        "requirement_id": "result_1",
        "probe": {
          "kind": "text",
          "selector": "#nnd-workflow-status"
        },
        "operator": "contains",
        "expected": "Invalid edge rejected"
      }
    ],
    "persist_reopen": [
      {
        "op": "reopen_app"
      },
      {
        "op": "click",
        "selector": "#nnd-verify-graph"
      },
      {
        "op": "wait_for",
        "selector": "#nnd-graph-verified",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "persist_reopen",
        "probe": {
          "kind": "backend_result",
          "binding_id": "neural-network-designer.ipfs_kit_py.retrieve_artifact",
          "pointer": "/result/result/content/0/json/metadata/kind"
        },
        "operator": "equals",
        "expected": "layers nnd-in,nnd-hidden,nnd-out edges nnd-e1,nnd-e2,nnd-bad params 4,2,2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#nnd-graph-summary"
        },
        "operator": "equals",
        "expected": "layers nnd-in,nnd-hidden,nnd-out edges nnd-e1,nnd-e2,nnd-bad params 4,2,2"
      }
    ],
    "failure_recovery": [
      {
        "op": "assert",
        "checkpoint_id": "error_observed",
        "probe": {
          "kind": "text",
          "selector": "#nnd-workflow-status"
        },
        "operator": "contains",
        "expected": "Compilation was not run."
      },
      {
        "op": "click",
        "selector": "#nnd-correct-shape"
      },
      {
        "op": "click",
        "selector": ".workflow-primary"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm='neural-network-designer.ipfs_kit_py.persist_artifact']",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm='neural-network-designer.ipfs_kit_py.persist_artifact']"
      },
      {
        "op": "wait_for",
        "selector": "#nnd-persist-ready",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "#nnd-verify-graph"
      },
      {
        "op": "wait_for",
        "selector": "#nnd-graph-verified",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "#nnd-run-inference"
      },
      {
        "op": "wait_for",
        "selector": "[data-gateway-confirm='neural-network-designer.ipfs_accelerate_py.run_inference_job']",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "click",
        "selector": "[data-gateway-confirm='neural-network-designer.ipfs_accelerate_py.run_inference_job']"
      },
      {
        "op": "wait_for",
        "selector": "#nnd-owner-job[data-owner-job='executed']",
        "state": "visible",
        "timeout_ms": 15000
      },
      {
        "op": "assert",
        "requirement_id": "failure_recovery",
        "probe": {
          "kind": "backend_result",
          "binding_id": "neural-network-designer.ipfs_kit_py.retrieve_artifact",
          "pointer": "/result/result/content/0/json/metadata/kind"
        },
        "operator": "equals",
        "expected": "layers nnd-in,nnd-hidden,nnd-out edges nnd-e1,nnd-e2 params 4,2,2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#nnd-recovered-proof"
        },
        "operator": "equals",
        "expected": "Recovered graph matches retrieved artifact: layers nnd-in,nnd-hidden,nnd-out edges nnd-e1,nnd-e2 params 4,2,2"
      },
      {
        "op": "assert",
        "probe": {
          "kind": "text",
          "selector": "#nnd-owner-job"
        },
        "operator": "contains",
        "expected": "Owner inference executed for saved graph"
      }
    ]
  }
}
