    },
    {
      "id": "phone-gps",
      "capability": "phone_gps.context",
      "sample": {
        "source": "phone-os-mock",
        "latitude": 37.789,
        "longitude": -122.401,
        "accuracy_m": 8
      }
    }
  ],
  "failure_modes": [
