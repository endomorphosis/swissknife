      ]
    }
  },
  "state_model": {
    "keys": [
      "title",
      "summary",
      "progress",
      "progress_label",
      "status",
      "selected_action",
      "last_error",
      "updated_at"
    ],
    "events": [
      "display.task_progress.telemetry"
    ],
    "replay": true
  },
  "meta_glasses_display": {
    "profile": "handsfree.meta-glasses/display-widget",
    "profile_version": "0.1.0",
    "target": {
      "display_class": "meta-ray-ban-display",
      "viewport": {
        "width": 600,
        "height": 600
      },
      "input": [
        "dpad",
        "gesture",
        "voice",
        "mobile_action"
      ],
      "render_path": "dat-native"
    },
    "layout": {
      "template": "task-progress",
      "regions": [
        {
          "id": "title",
          "kind": "text",
          "bounds": {
            "x": 24,
            "y": 24,
            "width": 552,
            "height": 72
          },
          "text": {
            "source": "state.title",
            "max_lines": 2,
            "max_chars": 64,
            "overflow": "truncate"
          }
        },
        {
          "id": "summary",
          "kind": "status",
          "bounds": {
            "x": 24,
            "y": 112,
            "width": 552,
            "height": 168
          },
          "text": {
            "source": "state.summary",
            "max_lines": 4,
            "max_chars": 180,
            "overflow": "wrap"
          }
        },
        {
          "id": "progress",
          "kind": "progress",
          "bounds": {
            "x": 24,
            "y": 304,
            "width": 552,
            "height": 120
          },
          "text": {
            "source": "state.progress_label",
            "max_lines": 2,
            "max_chars": 48,
            "overflow": "truncate"
          }
        },
        {
          "id": "pause-control",
          "kind": "action",
          "bounds": {
            "x": 24,
            "y": 464,
            "width": 264,
            "height": 80
          },
          "action_id": "pause"
        },
        {
          "id": "dismiss-control",
          "kind": "action",
          "bounds": {
            "x": 312,
            "y": 464,
            "width": 264,
            "height": 80
          },
          "action_id": "dismiss"
        }
      ],
      "focus_order": [
        "pause",
        "dismiss"
      ]
    },
    "constraints": {
      "max_text_blocks": 3,
      "max_actions": 2,
      "requires_high_contrast": true,
      "requires_focus_order": true,
      "max_update_hz": 2,
      "ttl_ms": 45000
    },
    "fallback": {
      "when": [
        "dat_native_display_unavailable",
        "display_unsupported",
        "session_not_ready"
      ],
      "render_path": "mobile-card",
      "message": "Display unavailable. Showing task progress on phone."
    },
    "actions": [
      {
        "id": "pause",
        "method": "activate",
        "backend_action_id": "handsfree.task.pause",
        "label": "Pause",
        "focusable": true,
        "service_id": "display-widget",
        "state_keys": [
          "selected_action"
        ]
      },
      {
        "id": "dismiss",
        "method": "clear_widget",
        "backend_action_id": "handsfree.widget.dismiss",
        "label": "Dismiss",
        "focusable": true,
        "service_id": "display-widget",
        "state_keys": [
          "selected_action"
        ]
      }
    ]
  }
}
