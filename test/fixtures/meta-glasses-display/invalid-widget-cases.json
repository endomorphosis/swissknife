    "id": "unsafe-display-contract",
    "title": "Unsafe display contract with invalid layout, actions, media, fallback, and required operations",
    "description": "A self-contained descriptor that remains structurally close to the valid task-progress widget while exercising the stable display validation errors.",
    "expected_error_codes": [
      "MGW_DISPLAY_VIEWPORT_MISSING",
      "MGW_RENDER_PATH_UNSUPPORTED",
      "MGW_FOCUS_ORDER_MISSING",
      "MGW_TEXT_UNBOUNDED",
      "MGW_MEDIA_TYPE_UNSUPPORTED",
      "MGW_ACTION_METHOD_UNBOUND",
      "MGW_METHOD_NOT_PRESENT",
      "MGW_UPDATE_RATE_UNSAFE",
      "MGW_CLEAR_RESET_MISSING",
      "MGW_FALLBACK_MISSING"
    ],
