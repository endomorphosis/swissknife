    "web/src/adapters/browser-storage-adapter.ts",
    "web/src/adapters/cli-adapter.ts",
    "web/src/adapters/task-adapter.ts",
    "web/src/adapters/task-adapter-new.ts",
    "web/src/components/P2PNetworkApp.ts",
    "web/src/components/TerminalApp.ts",
