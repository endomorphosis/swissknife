{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallucinate.app/contracts/swissknife_virtual_desktop_app_manifest.schema.json",
  "title": "SwissKnife virtual desktop app manifest",
  "description": "Canonical manifest for SwissKnife virtual desktop apps, generated service surfaces, aliases, IPFS/MCP capability families, and Meta glasses handoff strategy.",
  "type": "object",
  "required": ["manifest_id", "version", "generated_from", "apps"],
  "properties": {
    "manifest_id": {
      "type": "string",
      "const": "org.hallucinate.swissknife.virtual-desktop-app-manifest"
    },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "app": {
      "type": "object",
      "required": [
        "id",
        "canonical_id",
        "aliases",
        "title",
        "category",
        "owner_module",
        "launch_owner",
        "launch_kind",
        "capabilities",
        "service_families",
        "backend_capabilities",
        "orb_idl_state",
        "glasses_strategy",
        "ux_scenarios",
        "required_test_coverage"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "canonical_id": { "$ref": "#/$defs/kebabId" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/kebabId" },
          "uniqueItems": true
        },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "development",
            "ai",
            "storage",
            "system",
            "productivity",
            "integration",
            "automation",
            "network",
            "creative",
            "utility",
            "media",
            "social",
            "generated",
            "glasses"
          ]
        },
        "owner_module": {
          "type": "string",
          "enum": ["platform", "mcp", "glasses", "ipfs", "integrations", "shared"]
        },
        "launch_owner": { "$ref": "#/$defs/launchOwner" },
        "launch_kind": {
          "type": "string",
          "enum": ["static-app", "typescript-runtime", "idl-generated", "service-surface", "legacy-alias"]
        },
        "component": { "type": "string" },
        "source_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "web-index-desktop",
              "web-index-start-menu",
              "web-js-main",
              "web-js-main-simple",
              "browser-main",
              "list-all-applications",
              "batch-test-apps",
              "docs-applications",
              "glasses-registry",
              "idl-generated"
            ]
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "service_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "local",
              "ipfs_kit_py",
              "ipfs_datasets_py",
              "ipfs_accelerate_py",
              "mcp_plus_plus",
              "policy",
              "external_network",
              "meta_glasses",
              "orb"
            ]
          },
          "uniqueItems": true
        },
        "backend_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/backendCapability" },
          "uniqueItems": true
        },
        "local_only_rationale": { "type": "string", "minLength": 1 },
        "orb_idl_state": { "$ref": "#/$defs/orbIdlState" },
        "glasses_strategy": { "$ref": "#/$defs/glassesStrategy" },
        "ux_scenarios": { "$ref": "#/$defs/uxScenarios" },
        "required_test_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["manifest", "launch", "screenshot", "console", "network", "capability", "glasses", "alias"]
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "launchOwner": {
      "type": "object",
      "required": ["module", "source_sets"],
      "properties": {
        "module": {
          "type": "string",
          "enum": ["platform", "mcp", "glasses", "ipfs", "integrations", "shared"]
        },
        "component": { "type": "string" },
        "source_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "web-index-desktop",
              "web-index-start-menu",
              "web-js-main",
              "web-js-main-simple",
              "browser-main",
              "list-all-applications",
              "batch-test-apps",
              "docs-applications",
              "glasses-registry",
              "idl-generated"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "backendCapability": {
      "type": "object",
      "required": [
        "id",
        "service",
        "capability",
        "mcp_transport",
        "mcp_plus_plus_transport",
        "policy_class",
        "receipt_strategy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "service": {
          "type": "string",
          "enum": ["ipfs_kit_py", "ipfs_datasets_py", "ipfs_accelerate_py"]
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "mcp_transport": { "$ref": "#/$defs/transportEligibility" },
        "mcp_plus_plus_transport": { "$ref": "#/$defs/transportEligibility" },
        "policy_class": {
          "type": "string",
          "enum": ["read", "write", "heavy_compute", "credential", "external_network", "media_capture", "destructive"]
        },
        "receipt_strategy": {
          "type": "string",
          "enum": ["none", "descriptor", "receipt-required", "confirmation-receipt", "event-dag-receipt"]
        }
      },
      "additionalProperties": false
    },
    "transportEligibility": {
      "type": "string",
      "enum": ["eligible", "required", "not-eligible"]
    },
    "orbIdlState": {
      "type": "object",
      "required": ["state", "descriptor_owner", "mcp_plus_plus", "receipt_required"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["generated", "manual", "not-required"]
        },
        "descriptor_owner": {
          "type": "string",
          "enum": ["idl-generated", "manual-registry", "local-only"]
        },
        "mcp_plus_plus": { "$ref": "#/$defs/transportEligibility" },
        "receipt_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "uxScenarios": {
      "type": "object",
      "required": ["success", "fallback", "error"],
      "properties": {
        "success": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "glassesStrategy": {
      "type": "object",
      "required": ["kind", "handoff"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["manual", "idl-generated", "audio-summary", "mobile-card", "display-webapp", "fallback-only", "not-displayable"]
        },
        "handoff": {
          "type": "string",
          "enum": ["native-display", "display-webapp", "mobile-card", "notification", "audio-summary", "not-displayable"]
        },
        "profile_id": { "$ref": "#/$defs/kebabId" },
        "fallback": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["mobile-card", "notification", "audio-summary", "display-webapp", "desktop-only"]
          },
          "uniqueItems": true
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
