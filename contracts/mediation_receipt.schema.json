{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallucinate.app/contracts/mediation_receipt.schema.json",
  "title": "mediation_receipt",
  "description": "Audit receipt that links a normalized interaction, selected policy references, compiled logic artifacts, and the policy_decision emitted before invocation.",
  "$comment": "HAO-735 objective validation repair: interface contract swissknife external/meta-wearables-dat-android, goal_packet/interoperability/swissknife/06921590135c, tests/integration/test_swissknife_external_meta_wearables_dat_android_interop.py.",
  "type": "object",
  "required": [
    "receipt_id",
    "emitted_at",
    "control_surface_contract_ref",
    "interaction_envelope",
    "policy_decision",
    "policy_refs",
    "mediation_result"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "control_surface_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "interaction_envelope": {
      "$ref": "https://hallucinate.app/contracts/interaction_envelope.schema.json"
    },
    "policy_decision": {
      "$ref": "https://hallucinate.app/contracts/policy_decision.schema.json"
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policyRef"
      }
    },
    "mediation_result": {
      "$ref": "#/$defs/mediationResult"
    },
    "explanation": {
      "type": "string"
    },
    "receipt_links": {
      "type": "object",
      "properties": {
        "previous_receipt_id": {
          "type": "string"
        },
        "followup_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 1
    },
    "deonticOutcome": {
      "type": "string",
      "enum": ["allow", "deny", "require_confirmation", "defer", "rewrite", "fallback_surface", "rate_limit"]
    },
    "policyBundleRef": {
      "type": "object",
      "required": ["policy_id", "policy_cid"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_cid": {
          "$ref": "#/$defs/cid"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["descriptor", "operator_profile", "runtime_override", "remote_client", "system_default"]
        }
      },
      "additionalProperties": false
    },
    "compiledArtifactRef": {
      "type": "object",
      "required": ["artifact_type", "cid"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": ["frame_logic", "event_calculus", "deontic_policy", "ucan", "explanation", "source_text"]
        },
        "cid": {
          "$ref": "#/$defs/cid"
        },
        "media_type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policyRef": {
      "type": "object",
      "required": ["policy_bundle_ref", "compiled_policy_cid"],
      "properties": {
        "policy_bundle_ref": {
          "$ref": "#/$defs/policyBundleRef"
        },
        "compiled_policy_cid": {
          "$ref": "#/$defs/cid"
        },
        "matched_norm_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compiled_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compiledArtifactRef"
          }
        }
      },
      "additionalProperties": false
    },
    "mediationResult": {
      "type": "object",
      "required": ["outcome", "invoked", "final_method", "final_target_ref"],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/deonticOutcome"
        },
        "invoked": {
          "type": "boolean"
        },
        "final_method": {
          "type": "string"
        },
        "final_target_ref": {
          "type": "string"
        },
        "fallback_surface": {
          "type": "string"
        },
        "confirmation_required": {
          "type": "boolean"
        },
        "rate_limit_key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
