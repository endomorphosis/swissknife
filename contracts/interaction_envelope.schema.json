{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallucinate.app/contracts/interaction_envelope.schema.json",
  "title": "interaction_envelope",
  "description": "Canonical normalized interaction payload emitted by voice, gesture, pointer, remote client, and agent control surfaces before policy mediation.",
  "type": "object",
  "required": [
    "interaction_id",
    "surface",
    "surface_event",
    "raw_payload",
    "normalized_intent",
    "actor",
    "context"
  ],
  "properties": {
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "surface_event": {
      "type": "string",
      "minLength": 1
    },
    "raw_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "normalized_intent": {
      "$ref": "#/$defs/normalizedIntent"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "context": {
      "$ref": "#/$defs/runtimeContext"
    },
    "control_surface_contract_ref": {
      "type": "string",
      "description": "Descriptor or CID that supplied the active control_surface_contract."
    },
    "policy_bundle_ref": {
      "$ref": "#/$defs/policyBundleRef"
    },
    "compiled_policy_cid": {
      "$ref": "#/$defs/cid"
    },
    "logic_bindings": {
      "type": "array",
      "description": "Bindings selected from the descriptor for this interaction before policy evaluation.",
      "items": {
        "$ref": "#/$defs/selectedLogicBinding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 1
    },
    "policyBundleRef": {
      "type": "object",
      "required": ["policy_id", "policy_cid"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_cid": {
          "$ref": "#/$defs/cid"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["descriptor", "operator_profile", "runtime_override", "remote_client", "system_default"]
        }
      },
      "additionalProperties": false
    },
    "selectedLogicBinding": {
      "type": "object",
      "required": ["binding_id", "policy_bundle_ref", "compiled_policy_cid"],
      "properties": {
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_bundle_ref": {
          "$ref": "#/$defs/policyBundleRef"
        },
        "compiled_policy_cid": {
          "$ref": "#/$defs/cid"
        },
        "surface_ref": {
          "type": "string"
        },
        "method_ref": {
          "type": "string"
        },
        "norm_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "normalizedIntent": {
      "type": "object",
      "required": ["intent", "method", "target_ref", "arguments", "confidence"],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "arguments_hash": {
          "type": "string",
          "minLength": 1,
          "description": "Stable digest of normalized_intent.arguments for receipt correlation across SwissKnife, mobile, and DAT bridges."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["type", "id", "delegation_chain"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "agent", "system", "remote_client"]
        },
        "id": {
          "type": "string"
        },
        "delegation_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_identity": {
          "type": "object",
          "description": "Optional agent identity transported when the actor is an agent or remote client acting on behalf of an agent.",
          "properties": {
            "agent_id": {
              "type": "string"
            },
            "display_name": {
              "type": "string"
            },
            "credential_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimeContext": {
      "type": "object",
      "required": [
        "local_time",
        "state_frames",
        "device_mode",
        "platform",
        "location_context",
        "device_context"
      ],
      "properties": {
        "local_time": {
          "type": "string"
        },
        "state_frames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "device_mode": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "location_context": {
          "type": "object",
          "additionalProperties": true
        },
        "device_context": {
          "type": "object",
          "additionalProperties": true
        },
        "mobile_handoff": {
          "$ref": "#/$defs/mobileHandoffContext"
        }
      },
      "additionalProperties": false
    },
    "mobileHandoffContext": {
      "type": "object",
      "required": ["contract", "allowed_surfaces", "runtime_handoff"],
      "properties": {
        "contract": {
          "type": "string",
          "const": "handsfree.meta-glasses/swissknife-mobile-interop@0.1.0"
        },
        "allowed_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtime_handoff": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "descriptor_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
